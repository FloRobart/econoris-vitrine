---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV } from '../config/site';
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou plus." noindex>
  <section class="container page-hero notfound">
    <p class="eyebrow">Erreur 404</p>
    <h1>Cette page s'est dépensée toute seule.</h1>
    <p class="lead">Elle n'existe pas ou a été déplacée. Voici où vous pouvez aller :</p>
    <ul>
      <li><a href="/">Accueil</a></li>
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 60vh;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }
</style>
