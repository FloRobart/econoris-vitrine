---
import { SITE } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  /** Id unique si le composant apparaît plusieurs fois. */
  id?: string;
}
const { id = 'calc' } = Astro.props;
---

<section class="calc card" aria-labelledby={`${id}-title`} data-calc>
  <div class="calc-head">
    <span class="icon-chip"><Icon name="wallet" /></span>
    <div>
      <h3 id={`${id}-title`}>Combien pouvez-vous dépenser ce mois-ci ?</h3>
      <p>Faites le calcul en 10 secondes. Econoris le fait ensuite pour vous, tout au long du mois.</p>
    </div>
  </div>

  <form class="fields" onsubmit="return false">
    <label>
      <span>Revenus du mois <small>salaire, aides, primes…</small></span>
      <span class="input"><input type="number" inputmode="decimal" min="0" step="any" name="income" value="2150" /><em>€</em></span>
    </label>
    <label>
      <span>Dépenses fixes et abonnements <small>loyer, factures, forfaits…</small></span>
      <span class="input"><input type="number" inputmode="decimal" min="0" step="any" name="fixed" value="1050" /><em>€</em></span>
    </label>
    <label>
      <span>Déjà dépensé ce mois-ci <small>courses, sorties, carburant…</small></span>
      <span class="input"><input type="number" inputmode="decimal" min="0" step="any" name="spent" value="420" /><em>€</em></span>
    </label>
    <label>
      <span>Jour de paie <small>le jour où votre salaire arrive</small></span>
      <span class="input"><input type="number" inputmode="numeric" min="1" max="31" step="1" name="payday" value="28" /></span>
    </label>
  </form>

  <output class="result" for="income fixed spent payday" aria-live="polite">
    <span class="result-label">Reste possible à dépenser</span>
    <strong data-rest>680,00 €</strong>
    <span class="bar" aria-hidden="true"><span data-bar style="width: 32%"></span></span>
    <span class="per-day" data-day>soit environ 30 € par jour jusqu'à votre prochaine paie</span>
  </output>

  <p class="calc-cta">
    <a class="btn btn-primary" href={SITE.appUrl}>Suivre mon reste à dépenser gratuitement <Icon name="arrow-right" size={18} /></a>
  </p>
</section>

<script>
  const euro = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' });
  const euroRound = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

  const MILLISECONDS_PER_DAY = 24 * 60 * 60 * 1000;

  /**
   * Number of days from today (included) to the day before the next payday,
   * like the "financial month" of Econoris that goes from payday to payday.
   * A payday beyond the end of a month (e.g. 31 in November) falls on its last day.
   */
  function countDaysUntilNextPayday(payday: number): number {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const requestedDay = Math.min(31, Math.max(1, Math.round(payday) || 1));

    const paydayInMonth = (year: number, month: number) => {
      const lastDayOfMonth = new Date(year, month + 1, 0).getDate();
      return new Date(year, month, Math.min(requestedDay, lastDayOfMonth));
    };

    let nextPayday = paydayInMonth(today.getFullYear(), today.getMonth());
    if (nextPayday <= today) {
      nextPayday = paydayInMonth(today.getFullYear(), today.getMonth() + 1);
    }

    return Math.max(1, Math.round((nextPayday.getTime() - today.getTime()) / MILLISECONDS_PER_DAY));
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-calc]')) {
    const form = root.querySelector('form')!;
    const rest = root.querySelector<HTMLElement>('[data-rest]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const day = root.querySelector<HTMLElement>('[data-day]')!;
    const result = root.querySelector<HTMLElement>('.result')!;

    const read = (name: string) => {
      const value = parseFloat((form.elements.namedItem(name) as HTMLInputElement).value.replace(',', '.'));
      return Number.isFinite(value) ? Math.max(0, value) : 0;
    };

    const update = () => {
      const income = read('income');
      const remaining = income - read('fixed') - read('spent');
      const daysLeft = countDaysUntilNextPayday(read('payday'));

      rest.textContent = euro.format(remaining);
      const ratio = income > 0 ? Math.min(1, Math.max(0, remaining / income)) : 0;
      bar.style.width = `${Math.round(ratio * 100)}%`;
      result.dataset.state = remaining < 0 ? 'over' : ratio < 0.1 ? 'low' : 'ok';

      day.textContent =
        remaining < 0
          ? `Attention : vous dépassez votre budget de ${euro.format(-remaining)}`
          : `soit environ ${euroRound.format(remaining / daysLeft)} par jour pendant les ${daysLeft} jours restants avant votre prochaine paie`;
    };

    form.addEventListener('input', update);
    update();
  }
</script>

<style>
  .calc {
    padding: clamp(22px, 4vw, 36px);
    box-shadow: var(--shadow);
  }
  .calc-head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .calc-head .icon-chip {
    flex: none;
    margin: 0;
  }
  .calc-head h3 {
    font-size: 1.3rem;
  }
  .fields {
    display: grid;
    gap: 14px;
    margin: 1.5rem 0;
  }
  label {
    display: grid;
    grid-template-columns: 1fr minmax(120px, 160px);
    gap: 12px;
    align-items: center;
    font-weight: 700;
  }
  @media (max-width: 480px) {
    label {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
  label small {
    display: block;
    font-weight: 500;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .input {
    position: relative;
  }
  .input em {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-style: normal;
    color: var(--muted);
    pointer-events: none;
  }
  input {
    width: 100%;
    min-height: 48px;
    padding: 0.6rem 2.2rem 0.6rem 0.9rem;
    font: inherit;
    font-weight: 700;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-align: right;
  }
  input:focus {
    outline: none;
    border-color: var(--brand-strong);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 35%, transparent);
  }
  .result {
    display: grid;
    gap: 6px;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-sm);
    background: var(--success-soft);
    color: var(--success);
    border: 1px solid color-mix(in srgb, var(--success) 25%, transparent);
  }
  .result[data-state='low'] {
    --success: #b26a00;
    background: color-mix(in srgb, #ff9800 12%, transparent);
  }
  .result[data-state='over'] {
    --success: var(--danger);
    background: color-mix(in srgb, var(--danger) 10%, transparent);
  }
  .result-label {
    font-weight: 700;
  }
  .result strong {
    font-size: clamp(2rem, 6vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .bar {
    height: 8px;
    border-radius: 99px;
    background: color-mix(in srgb, currentColor 15%, transparent);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: currentColor;
    border-radius: inherit;
    transition: width 0.25s ease;
  }
  .per-day {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .calc-cta {
    margin: 1.5rem 0 0;
  }
  .calc-cta .btn {
    white-space: normal;
    text-align: center;
  }
</style>
