---
import { SITE } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Prêt à savoir ce que vous pouvez dépenser ?',
  text = 'Gratuit, sans publicité, sans connexion bancaire. Un email suffit pour commencer.',
} = Astro.props;
---

<section class="container cta-wrap">
  <div class="cta">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="actions">
      <a class="btn btn-primary" href={SITE.appUrl}>Commencer gratuitement <Icon name="arrow-right" size={18} /></a>
      <a class="btn btn-ghost" href="/installer/">Voir comment l'installer</a>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: clamp(48px, 8vw, 88px);
  }
  .cta {
    text-align: center;
    padding: clamp(32px, 6vw, 64px) clamp(20px, 5vw, 48px);
    border-radius: 28px;
    background:
      radial-gradient(120% 120% at 0% 0%, color-mix(in srgb, var(--brand) 40%, transparent), transparent 55%),
      radial-gradient(120% 120% at 100% 100%, color-mix(in srgb, var(--brand) 28%, transparent), transparent 55%),
      var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .cta p {
    color: var(--ink-soft);
    font-size: 1.1rem;
    max-width: 560px;
    margin-inline: auto;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .actions .btn-ghost {
    background: var(--surface);
  }
</style>
